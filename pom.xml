<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    
    <groupId>io.github.yak33</groupId>
    <artifactId>smart-customs-platform-cloud</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>
    
    <name>smart-customs-platform-cloud</name>
    <description>智慧关务平台 - 微服务版本</description>
    
    <properties>
        <revision>0.0.1-SNAPSHOT</revision>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- Spring Boot 版本 (供子模块插件引用) -->
        <spring-boot.version>3.4.2</spring-boot.version>
        <!-- 注解处理器版本 -->
        <lombok.version>1.18.40</lombok.version>
        <mapstruct-plus.version>1.5.0</mapstruct-plus.version>
    </properties>
    
    <modules>
        <module>smart-customs-dependencies</module>
        <module>smart-customs-common</module>
        <module>smart-customs-api</module>
		<module>smart-customs-nacos</module>
        <module>smart-customs-gateway</module>
        <module>smart-customs-system</module>
        <module>smart-customs-business</module>
    </modules>
    
    <dependencyManagement>
        <dependencies>
            <!-- 引入依赖管理 BOM -->
            <dependency>
                <groupId>io.github.yak33</groupId>
                <artifactId>smart-customs-dependencies</artifactId>
                <version>${revision}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    
    <build>
        <plugins>
            <!-- 统一版本号管理 -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>1.3.0</version>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    
    <!-- 环境配置 -->
    <profiles>
        <profile>
            <id>dev</id>
            <properties>
                <!-- 环境标识，需要与配置文件名称相对应 -->
                <profiles.active>dev</profiles.active>
                <!-- Nacos 配置 -->
                <nacos.server>127.0.0.1:8848</nacos.server>
                <nacos.namespace></nacos.namespace>
                <nacos.group>SMART_CUSTOMS_GROUP</nacos.group>
                <nacos.username>nacos</nacos.username>
                <nacos.password>cnmngdxB999!~!</nacos.password>
                <nacos.config.enabled>true</nacos.config.enabled>
                <nacos.discovery.enabled>true</nacos.discovery.enabled>
            </properties>
            <activation>
                <!-- 默认环境 -->
                <activeByDefault>true</activeByDefault>
            </activation>
        </profile>
        <profile>
            <id>prod</id>
            <properties>
                <profiles.active>prod</profiles.active>
                <nacos.server>nacos:8848</nacos.server>
                <nacos.namespace></nacos.namespace>
                <nacos.group>SMART_CUSTOMS_GROUP</nacos.group>
                <nacos.username>nacos</nacos.username>
                <nacos.password>cnmngdxB999!~!</nacos.password>
                <nacos.config.enabled>true</nacos.config.enabled>
                <nacos.discovery.enabled>true</nacos.discovery.enabled>
            </properties>
        </profile>
    </profiles>
    
    <repositories>
        <repository>
            <id>public</id>
            <name>huawei nexus</name>
            <url>https://mirrors.huaweicloud.com/repository/maven/</url>
            <releases>
                <enabled>true</enabled>
            </releases>
        </repository>
    </repositories>
    
    <pluginRepositories>
        <pluginRepository>
            <id>public</id>
            <name>huawei nexus</name>
            <url>https://mirrors.huaweicloud.com/repository/maven/</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </pluginRepository>
    </pluginRepositories>

</project>
